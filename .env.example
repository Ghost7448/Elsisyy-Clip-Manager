PORT=3000
NODE_ENV=development

# Create an app at https://dev.kick.com
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Must exactly match the Redirect URL configured in your Kick app.
KICK_REDIRECT_URI=http://localhost:3000/auth/kick/callback

# Use a long random secret (32+ characters).
SESSION_SECRET=

# For Railway, mount a persistent volume at /data and keep this path.
SESSION_DB_PATH=./data/sessions.sqlite
